
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create Tenant</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/alert.css" />
    <link rel="stylesheet" href="/css/tenantcreate.css" />
</head>
<body>
    <div id="divStep1" class="row login-box">
        <div class="col-12 right">
            <p>Workspace Register</p>
            <div class="login-input">
                <i class="bi bi-database"></i>
                <input id="txtTenantID" type="text" class="form-control form-control-sm custom-input" placeholder="Tenant ID" />
            </div>
            <div class="login-input">
                <i class="bi bi-buildings"></i>
                <input id="txtCompanyName" type="text" class="form-control form-control-sm custom-input" placeholder="Company Name" />
            </div>
            <div class="tenant-actionbox">
                <a href="/0/Tenant/HomePage" class="btn btn-dark">Cancel</a>
                <button id="btnNext" class="btn btn-info">Next</button>
            </div>
        </div>
    </div>
    <div id="divStep2" class="row login-box" style="display:none">
        <div class="col-12 right">
            <p>Admin Register</p>
            <div class="login-input">
                <i class="bi bi-envelope"></i>
                <input id="txtEmail" type="text" class="form-control form-control-sm custom-input" placeholder="Email" />
            </div>
            <div class="login-input">
                <i class="bi bi-shield-lock"></i>
                <input id="txtPassword" type="password" class="form-control form-control-sm custom-input" placeholder="Password" />
            </div>
            <div class="login-input">
                <i class="bi bi-person"></i>
                <input id="txtName" type="text" class="form-control form-control-sm custom-input" placeholder="Name" />
            </div>
            <div class="login-input">
                <i class="bi bi-view-stacked"></i>
                <select id="ddlPosition" class="form-select form-select-sm custom-input">
                    <option value="owner">Owner</option>
                    <option value="manager">Manager</option>
                    <option value="staff">Staff</option>
                </select>
            </div>
            <div class="login-input">
                <i class="bi bi-phone"></i>
                <input id="txtMobileNo" type="text" class="form-control form-control-sm custom-input" placeholder="Mobile Number" />
            </div>
            <div class="tenant-actionbox">
                <button id="btnBack" class="btn btn-dark">Back</button>
                <button id="btnRegister" class="btn btn-info">Register</button> 
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.7.7/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="/js/service.js?v=@ViewBag.JsVersion"></script>
    <script src="/js/tenantregister.js?v=@ViewBag.JsVersion"></script>
</body>
</html>
