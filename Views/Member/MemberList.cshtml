
@{
    Layout =  "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="/css/memberlist.css" />

<div id="divList" class="card">
    <h6 class="card-header"> 2025 年01月 </h6>
    <div class="card-body">
        <button id="btnNewMember" class="btn btn-info">New Member</button>
        <table id="tblMember" class="table table-sm table-hover table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>User ID / Name</th>
                    <th>Name_Role</th>
                    <th>Position</th>
                    <th>User Role</th>
                    <th>Register Date & Time</th>
                    <th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>
 

<input type="file" id="fileInput" style="display: none;" accept="image/*">
<input type="hidden" id="hfMode" />

<script src="/js/memberlist.js?v=@ViewBag.JsVersion"></script>
